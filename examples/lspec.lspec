--- "LangSpec DSL" v0.0.0 | lspec v1.0.0 ---

PRAGMA {
	tool.sublime {
		enable = true;
		output-path = "/home/user/.config/sublime-text/Packages/User/LSpec.sublime-syntax";
	}
	
	tool.go_bindings {
		enable = true;
		output-path = "libs/langspec/examples/generated_go_bindings.go";
		package-name = "compiler";
	}
}

PATTERN {
	pat_TokDashes : "---";
	pat_TokMetaSection : "%%";
	pat_TokPipe : "|";
	pat_TokDot : ".";
	pat_TokSemicolon : ";";
	pat_TokBraceOpen : "{";
	pat_TokBraceClose : "}";
	pat_TokParenOpen : "(";
	pat_TokParenClose : ")";
	pat_TokBracketOpen : "[";
	pat_TokBracketClose : "]";
	pat_TokComma : ",";
	pat_TokPlus : "+";
	pat_TokNegation : "!";
	pat_TokAssignment : ":";
	pat_TokChainSeparator : "->";
	pat_TokEqualsOperator : "=";
	pat_TokOptional : "?";
	pat_TokRange : "..";
	pat_TokStar : "*";
	pat_TokKWLSpec : "lspec";
	pat_TokKWPragma : "PRAGMA";
	pat_TokKWTool : "tool";
	pat_TokKWLex : "LEX";
	pat_TokKWPattern : "PATTERN";
	pat_TokKWPratt : "PRATT";
	pat_TokKWTrue : "true";
	pat_TokKWFalse : "false";
	pat_TokKWLocal : "local";
	pat_TokKWParse : "PARSE";
	pat_TokKWVirtual : "virtual";
	pat_TokKWNest : "nest";
	pat_TokKWPrimary : "primary";
	pat_TokKWPrefix : "prefix";
	pat_TokKWPostfix : "postfix";
	pat_TokKWInfix : "infix";
	pat_TokKWImplicit : "implicit";
	pat_TokKWPrecedence : "precedence";
	pat_TokKWIgnore : "IGNORE";
	pat_TokKWTransparent : "transparent";
	pat_TokKWSync : "sync";
	pat_TokKWPredict : "predict";
	pat_TokEOF : [];
	pat_TokWhitespace : (['\t', '\n', '\r', ' '])+;
	pat_TokLineComment : "/" "/" (!['\n', '\r'])*;
	pat_TokBlockComment : "/" "*" ((!'*' | ("*")+ !['*', '/']))* ("*")+ "/";
	pat_TokInteger : ('0'..'9')+;
	pat_TokStringLiteral : "\"" ((!['\n', '\r', '"', '\\'] | ("\\" ['"', '\\', 'n', 'r', 't'] | ("\\u" (['0'..'9', 'A'..'F', 'a'..'f']){4,4} | "\\U" (['0'..'9', 'A'..'F', 'a'..'f']){8,8}))))* "\"";
	pat_TokRegexLiteral : "`" ((!['\\', '`'] | "\\" '\u0000'..'\U0010FFFF'))* "`";
	pat_TokVersion : "v" ('0'..'9')+ "." ('0'..'9')+ "." ('0'..'9')+;
	pat_TokCharLiteral : "'" (!['\n', '\r', '\'', '\\'] | ("\\" ['\'', '\\', 'n', 'r', 't'] | ("\\u" (['0'..'9', 'A'..'F', 'a'..'f']){4,4} | "\\U" (['0'..'9', 'A'..'F', 'a'..'f']){8,8}))) "'";
	pat_TokIdentifier : ['A'..'Z', '_', 'a'..'z'] (['-', '0'..'9', 'A'..'Z', '_', 'a'..'z'])*;
}

LEX {
	2 TokKWFalse        -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWFalse       ;
	2 TokKWIgnore       -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWIgnore      ;
	2 TokKWImplicit     -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWImplicit    ;
	2 TokKWInfix        -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWInfix       ;
	2 TokKWLSpec        -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWLSpec       ;
	2 TokKWLex          -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWLex         ;
	2 TokKWLocal        -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWLocal       ;
	2 TokKWNest         -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWNest        ;
	2 TokKWParse        -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWParse       ;
	2 TokKWPattern      -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWPattern     ;
	2 TokKWPostfix      -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWPostfix     ;
	2 TokKWPragma       -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWPragma      ;
	2 TokKWPratt        -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWPratt       ;
	2 TokKWPrecedence   -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWPrecedence  ;
	2 TokKWPredict      -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWPredict     ;
	2 TokKWPrefix       -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWPrefix      ;
	2 TokKWPrimary      -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWPrimary     ;
	2 TokKWSync         -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWSync        ;
	2 TokKWTool         -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWTool        ;
	2 TokKWTransparent  -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWTransparent ;
	2 TokKWTrue         -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWTrue        ;
	2 TokKWVirtual      -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWVirtual     ;
	
	1 TokCharLiteral    -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokCharLiteral   ;
	1 TokIdentifier     -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokIdentifier    ;
	1 TokRegexLiteral   -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokRegexLiteral  ;
	1 TokStringLiteral  -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokStringLiteral ;
	1 TokVersion        -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokVersion       ;
	
	0 TokAssignment     -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokAssignment    ;
	0 TokBlockComment   -> LANG_SPEC_COMMENT_ROLE    : pat_TokBlockComment  ;
	0 TokBraceClose     -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokBraceClose    ;
	0 TokBraceOpen      -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokBraceOpen     ;
	0 TokBracketClose   -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokBracketClose  ;
	0 TokBracketOpen    -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokBracketOpen   ;
	0 TokChainSeparator -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokChainSeparator;
	0 TokComma          -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokComma         ;
	0 TokDashes         -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokDashes        ;
	0 TokDot            -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokDot           ;
	0 TokEOF            -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokEOF            %% EOF=true %%;
	0 TokEqualsOperator -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokEqualsOperator;
	0 TokInteger        -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokInteger       ;
	0 TokLineComment    -> LANG_SPEC_COMMENT_ROLE    : pat_TokLineComment   ;
	0 TokMetaSection    -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokMetaSection   ;
	0 TokNegation       -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokNegation      ;
	0 TokOptional       -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokOptional      ;
	0 TokParenClose     -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokParenClose    ;
	0 TokParenOpen      -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokParenOpen     ;
	0 TokPipe           -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokPipe          ;
	0 TokPlus           -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokPlus          ;
	0 TokRange          -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokRange         ;
	0 TokSemicolon      -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokSemicolon     ;
	0 TokStar           -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokStar          ;
	0 TokWhitespace     -> LANG_SPEC_WHITESPACE_ROLE : pat_TokWhitespace    ;
}

PRATT {
	// In an automatically generated .lspec file, pratt is not present.
	// Namely, it has been "resolved"/"flattened" into normal parsing rules.
}

PARSE {
	IGNORE {
		LANG_SPEC_COMMENT_ROLE LANG_SPEC_WHITESPACE_ROLE
	};
	
	DUMMY_CHOICE_FOR_PATTERNS -> transparent gr_DUMMY_CHOICE_FOR_PATTERNS {
		DUMMY_LOCAL_VAR_FOR_PATTERNS | NodePatternDefName : TokIdentifier
	};
	
	DUMMY_CHOICE_NEST -> transparent gr_DUMMY_CHOICE_NEST {
		NodeParseExpressionReference : TokIdentifier | PARSE_NEST_BODY
	};
	
	DUMMY_LOCAL_VAR_FOR_PATTERNS -> transparent gr_DUMMY_LOCAL_VAR_FOR_PATTERNS {
		NodeLocalVariable : TokKWLocal
		NodePatternDefName : TokIdentifier
	};
	
	HEADER -> transparent gr_HEADER sync (TokDashes) {
		nest TokDashes TokDashes {
			HEADER_CONTENT
		}
	};
	
	HEADER_CONTENT -> NodeHeader {
		NodeDSLName : TokStringLiteral
		NodeVersion : TokVersion
		virtual TokPipe
		NodeLSPECName : TokKWLSpec
		NodeVersion : TokVersion
	};
	
	LEX_RULE -> NodeLexRule sync (TokSemicolon) {
		NodeLexRulePriority : TokInteger?
		NodeLexRuleTokenName : TokIdentifier
		virtual TokChainSeparator
		NodeLexRuleRole : TokIdentifier
		virtual TokAssignment
		(
			LEX_RULE_PATTERN
		)
		META_SECTION?
		virtual TokSemicolon
	};
	
	LEX_RULE_LIST -> transparent gr_LEX_RULE_LIST sync (TokSemicolon) {
		(
			LEX_RULE
		)*
	};
	
	LEX_RULE_PATTERN -> transparent gr_LEX_RULE_PATTERN {
		PATTERN_REF | NodeLexRulePattern : TokRegexLiteral
	};
	
	LEX_SECTION -> NodeLexSection {
		NodeLexKeyword : TokKWLex
		LEX_SECTION_BLOCK_NEST
		virtual TokSemicolon?
	};
	
	LEX_SECTION_BLOCK_NEST -> transparent gr_LEX_SECTION_BLOCK_NEST sync (TokBraceClose) {
		nest TokBraceOpen TokBraceClose {
			LEX_RULE_LIST
		}
	};
	
	META_KEY_VALUE_PAIR -> transparent gr_META_KEY_VALUE_PAIR {
		(
			META_KEY_VALUE_SEQUENCE
		)*
	};
	
	META_KEY_VALUE_SEQUENCE -> NodeMetaKeyValuePair {
		NodeMetaKey : TokIdentifier
		virtual TokEqualsOperator
		(
			NodeMetaValue : (
				virtual TokStringLiteral | virtual TokKWFalse | virtual TokKWTrue
			)
		)
	};
	
	META_SECTION -> NodeMetaSection sync (TokMetaSection) {
		nest TokMetaSection TokMetaSection {
			META_KEY_VALUE_PAIR
		}
	};
	
	PARSE_EXPRESSION -> transparent gr_PARSE_EXPRESSION {
		PARSE_EXPRESSION_BP_10
	};
	
	PARSE_EXPRESSION_BP_10 -> transparent gr_PARSE_EXPRESSION_BP_10 {
		PARSE_EXPRESSION_BP_20
		(
			virtual TokPipe
			PARSE_EXPRESSION_BP_20
		)*
	};
	
	PARSE_EXPRESSION_BP_20 -> transparent gr_PARSE_EXPRESSION_BP_20 {
		PARSE_EXPRESSION_BP_30
		PARSE_EXPRESSION_BP_30*
	};
	
	PARSE_EXPRESSION_BP_30 -> transparent gr_PARSE_EXPRESSION_BP_30 {
		PARSE_EXPRESSION_BP_40
		(
			virtual TokOptional | virtual TokStar | virtual TokPlus | REPETITION_BOUNDS_NEST
		)*
	};
	
	PARSE_EXPRESSION_BP_40 -> transparent gr_PARSE_EXPRESSION_BP_40 {
		(
			PARSE_MODIFIER_PREDICT
		)*
		(
			PARSE_SEGMENT
		)
	};
	
	PARSE_GROUP -> NodeParseGroup sync (TokParenClose) {
		nest TokParenOpen TokParenClose PARSE_EXPRESSION
	};
	
	PARSE_IGNORE_ROLE_LIST -> transparent gr_PARSE_IGNORE_ROLE_LIST {
		NodeParseIgnoreRole : TokIdentifier*
	};
	
	PARSE_IGNORE_SECTION -> NodeParseIgnoreSection sync (TokBraceClose) {
		NodeParseIgnoreKeyword : TokKWIgnore
		PARSE_IGNORE_SECTION_BLOCK_NEST
		virtual TokSemicolon?
	};
	
	PARSE_IGNORE_SECTION_BLOCK_NEST -> transparent gr_PARSE_IGNORE_SECTION_BLOCK_NEST sync (TokBraceClose) {
		nest TokBraceOpen TokBraceClose {
			PARSE_IGNORE_ROLE_LIST
		}
	};
	
	PARSE_MODIFIER_PREDICT -> NodeParseModifierPredict {
		virtual TokKWPredict
		PREDICT_LOOKAHEAD_LIST
	};
	
	PARSE_NEST_BODY -> NodeParseNestBody sync (TokBraceClose) {
		nest TokBraceOpen TokBraceClose PARSE_EXPRESSION
	};
	
	PARSE_OP_NEST -> NodeParseOpNest {
		virtual TokKWNest
		NodeParseNestOpenToken : TokIdentifier
		NodeParseNestCloseToken : TokIdentifier
		(
			RULE_MODIFIER_SYNC
		)?
		(
			DUMMY_CHOICE_NEST
		)
	};
	
	PARSE_OP_SUPPRESS -> NodeParseOpSuppress {
		virtual TokKWVirtual
		NodeParseTokenReference : TokIdentifier
	};
	
	PARSE_RULE -> NodeParseRule sync (TokSemicolon) {
		NodeParseRuleName : TokIdentifier
		virtual TokChainSeparator
		NodeRuleModifierTransparent : TokKWTransparent?
		NodeParseNodeName : TokIdentifier
		(
			RULE_MODIFIER_SYNC
		)?
		PARSE_RULE_BODY
		virtual TokSemicolon?
	};
	
	PARSE_RULE_BODY -> NodeParseRuleBody sync (TokBraceClose) {
		nest TokBraceOpen TokBraceClose PARSE_EXPRESSION_BP_10
	};
	
	PARSE_RULE_LIST -> transparent gr_PARSE_RULE_LIST sync (TokSemicolon) {
		(
			PARSE_RULE
		)*
	};
	
	PARSE_SECTION -> NodeParseSection {
		NodeParseKeyword : TokKWParse
		PARSE_SECTION_BLOCK_NEST
		virtual TokSemicolon?
	};
	
	PARSE_SECTION_BLOCK_NEST -> transparent gr_PARSE_SECTION_BLOCK_NEST sync (TokBraceClose) {
		nest TokBraceOpen TokBraceClose {
			PARSE_SECTION_BODY
		}
	};
	
	PARSE_SECTION_BODY -> NodeParseSectionBody {
		(
			PARSE_IGNORE_SECTION
		)?
		PARSE_RULE_LIST
	};
	
	PARSE_SEGMENT -> transparent gr_PARSE_SEGMENT {
		PARSE_OP_SUPPRESS
		| PARSE_OP_NEST
		| PARSE_GROUP
		| PARSE_SEGMENT_IDENT_MAPPING_OR_REF
	};
	
	PARSE_SEGMENT_IDENT_MAPPING_OR_REF -> NodeParseSegment {
		NodeParseSymbolReference : TokIdentifier
		(
			PARSE_SEGMENT_TAIL
		)?
	};
	
	PARSE_SEGMENT_TAIL -> NodeParseSegment {
		virtual TokAssignment
		(
			PARSE_SEGMENT_TAIL_CHOICE
		)
	};
	
	PARSE_SEGMENT_TAIL_CHOICE -> transparent gr_PARSE_SEGMENT_TAIL_CHOICE {
		PARSE_GROUP | NodeParseTokenReference : TokIdentifier
	};
	
	PATTERN_CLASS -> NodePatternClass sync (TokBracketClose) {
		nest TokBracketOpen TokBracketClose {
			PATTERN_CLASS_ITEM_LIST
		}
	};
	
	PATTERN_CLASS_ITEM_COMMA -> NodePatternClassItem {
		PATTERN_CLASS_ITEM_SEQ
		virtual TokComma?
	};
	
	PATTERN_CLASS_ITEM_LIST -> transparent gr_PATTERN_CLASS_ITEM_LIST {
		(
			PATTERN_CLASS_ITEM_COMMA
		)*
	};
	
	PATTERN_CLASS_ITEM_SEQ -> NodePatternClassItem {
		NodeCharLiteral : TokCharLiteral
		(
			PATTERN_RANGE_TAIL
		)?
	};
	
	PATTERN_DEFINITION -> NodePatternDefinition sync (TokSemicolon) {
		(
			DUMMY_CHOICE_FOR_PATTERNS
		)
		virtual TokAssignment
		PATTERN_EXPRESSION
		virtual TokSemicolon
	};
	
	PATTERN_DEFINITION_LIST -> transparent gr_PATTERN_DEFINITION_LIST sync (TokSemicolon) {
		(
			PATTERN_DEFINITION
		)*
	};
	
	PATTERN_EXPRESSION -> transparent gr_PATTERN_EXPRESSION {
		PATTERN_EXPRESSION_BP_10
	};
	
	PATTERN_EXPRESSION_BP_10 -> transparent gr_PATTERN_EXPRESSION_BP_10 {
		PATTERN_EXPRESSION_BP_20
		(
			virtual TokPipe
			PATTERN_EXPRESSION_BP_20
		)*
	};
	
	PATTERN_EXPRESSION_BP_20 -> transparent gr_PATTERN_EXPRESSION_BP_20 {
		PATTERN_EXPRESSION_BP_30
		PATTERN_EXPRESSION_BP_30*
	};
	
	PATTERN_EXPRESSION_BP_30 -> transparent gr_PATTERN_EXPRESSION_BP_30 {
		PATTERN_EXPRESSION_BP_40
		(
			virtual TokStar | virtual TokPlus | virtual TokOptional | REPETITION_BOUNDS_NEST
		)*
	};
	
	PATTERN_EXPRESSION_BP_40 -> transparent gr_PATTERN_EXPRESSION_BP_40 {
		virtual TokNegation*
		PATTERN_EXPRESSION_BP_60
	};
	
	PATTERN_EXPRESSION_BP_60 -> transparent gr_PATTERN_EXPRESSION_BP_60 {
		(
			PATTERN_SEGMENT
		)
		(
			virtual TokRange
			(
				PATTERN_SEGMENT
			)
		)*
	};
	
	PATTERN_GROUP -> NodePatternGroup sync (TokParenClose) {
		nest TokParenOpen TokParenClose PATTERN_EXPRESSION
	};
	
	PATTERN_RANGE_TAIL -> NodePatternRange {
		virtual TokRange
		NodeCharLiteral : TokCharLiteral
	};
	
	PATTERN_REF -> transparent gr_NodePatternRef {
		NodePatternRef : TokIdentifier
	};
	
	PATTERN_SECTION -> NodePatternSection sync (TokSemicolon TokBraceClose) {
		NodePatternKeyword : TokKWPattern
		PATTERN_SECTION_BLOCK_NEST
		virtual TokSemicolon?
	};
	
	PATTERN_SECTION_BLOCK_NEST -> transparent gr_PATTERN_SECTION_BLOCK_NEST sync (TokBraceClose) {
		nest TokBraceOpen TokBraceClose {
			PATTERN_DEFINITION_LIST
		}
	};
	
	PATTERN_SEGMENT -> transparent gr_PATTERN_SEGMENT {
		PATTERN_REF
		| PATTERN_CLASS
		| NodeCharLiteral : TokCharLiteral
		| NodePatternAny : TokDot
		| NodePatternRegEx : TokRegexLiteral
		| NodeStringLiteral : TokStringLiteral
		| PATTERN_GROUP
	};
	
	PRAGMA_BLOCK -> NodePragmaBlock sync (TokSemicolon TokBraceClose) {
		PRAGMA_BLOCK_KEY
		PRAGMA_BLOCK_BLOCK_NEST
		virtual TokSemicolon?
	};
	
	PRAGMA_BLOCK_BLOCK_NEST -> transparent gr_PRAGMA_BLOCK_BLOCK_NEST sync (TokBraceClose) {
		nest TokBraceOpen TokBraceClose {
			PRAGMA_CONFIGURATION_LIST
		}
	};
	
	PRAGMA_BLOCK_KEY -> NodePragmaBlockKey {
		NodePragmaBlockKeyPrefix : TokKWTool
		PRAGMA_BLOCK_KEY_sep
		PRAGMA_BLOCK_KEY_tail
	};
	
	PRAGMA_BLOCK_KEY_sep -> transparent gr_PRAGMA_BLOCK_KEY_sep {
		virtual TokDot
		NodePragmaBlockKeySegment : TokIdentifier
	};
	
	PRAGMA_BLOCK_KEY_tail -> transparent gr_PRAGMA_BLOCK_KEY_tail {
		(
			PRAGMA_BLOCK_KEY_sep
		)*
	};
	
	PRAGMA_BLOCK_LIST -> transparent gr_PRAGMA_BLOCK_LIST sync (TokSemicolon TokBraceClose) {
		(
			PRAGMA_BLOCK
		)*
	};
	
	PRAGMA_CONFIGURATION -> NodePragmaConfiguration sync (TokSemicolon) {
		NodePragmaKey : TokIdentifier
		virtual TokEqualsOperator
		(
			NodePragmaValue : (
				virtual TokIdentifier
				| virtual TokStringLiteral
				| virtual TokKWTrue
				| virtual TokKWFalse
			)
		)
		virtual TokSemicolon
	};
	
	PRAGMA_CONFIGURATION_LIST -> transparent gr_PRAGMA_CONFIGURATION_LIST sync (TokSemicolon) {
		(
			PRAGMA_CONFIGURATION
		)*
	};
	
	PRAGMA_SECTION -> NodePragmaSection sync (TokSemicolon TokBraceClose) {
		NodePragmaKeyword : TokKWPragma
		PRAGMA_SECTION_BLOCK_NEST
		virtual TokSemicolon?
	};
	
	PRAGMA_SECTION_BLOCK_NEST -> transparent gr_PRAGMA_SECTION_BLOCK_NEST sync (TokBraceClose) {
		nest TokBraceOpen TokBraceClose {
			PRAGMA_BLOCK_LIST
		}
	};
	
	PRATT_CATEGORY -> transparent gr_PRATT_CATEGORY {
		PRATT_PRIMARY | PRATT_PREFIX | PRATT_POSTFIX | PRATT_INFIX | PRATT_IMPLICIT
	};
	
	PRATT_CATEGORY_LIST -> transparent gr_PRATT_CATEGORY_LIST {
		(
			PRATT_CATEGORY
		)*
	};
	
	PRATT_EXPR_BODY -> NodePrattExprBody sync (TokBraceClose) {
		nest TokBraceOpen TokBraceClose {
			PRATT_CATEGORY_LIST
		}
	};
	
	PRATT_EXPR_DEF -> NodePrattExprDef {
		NodeLocalVariable : TokKWLocal?
		NodePrattExprName : TokIdentifier
		(
			RULE_MODIFIER_SYNC
		)?
		PRATT_EXPR_BODY
	};
	
	PRATT_EXPR_DEF_LIST -> transparent gr_PRATT_EXPR_DEF_LIST {
		(
			PRATT_EXPR_DEF
		)*
	};
	
	PRATT_IMPLICIT -> NodePrattImplicit {
		NodePrattKeyword : TokKWImplicit
		PRATT_IMPLICIT_BODY
	};
	
	PRATT_IMPLICIT_BODY -> NodePrattImplicitBody sync (TokBraceClose) {
		nest TokBraceOpen TokBraceClose {
			PRATT_IMPLICIT_DEF
		}
	};
	
	PRATT_IMPLICIT_DEF -> NodePrattImplicitDef {
		virtual TokChainSeparator
		NodeParseNodeName : TokIdentifier
		virtual TokKWPrecedence
		NodePrattLeftPrecedenceValue : TokInteger
		NodePrattRightPrecedenceValue : TokInteger
		virtual TokSemicolon
	};
	
	PRATT_INFIX -> NodePrattInfix {
		NodePrattKeyword : TokKWInfix
		PRATT_INFIX_BODY
	};
	
	PRATT_INFIX_BODY -> NodePrattInfixBody sync (TokBraceClose) {
		nest TokBraceOpen TokBraceClose {
			PRATT_INFIX_LIST
		}
	};
	
	PRATT_INFIX_LIST -> transparent gr_PRATT_INFIX_LIST {
		(
			PRATT_OPERATOR_DEF_INFIX
		)*
	};
	
	PRATT_OPERATOR_DEF_INFIX -> NodePrattOperatorDef {
		NodeParseSymbolReference : TokIdentifier
		virtual TokChainSeparator
		NodeParseNodeName : TokIdentifier
		virtual TokKWPrecedence
		NodePrattLeftPrecedenceValue : TokInteger
		NodePrattRightPrecedenceValue : TokInteger
		virtual TokSemicolon
	};
	
	PRATT_OPERATOR_DEF_POSTFIX -> NodePrattOperatorDef {
		NodeParseSymbolReference : TokIdentifier
		virtual TokChainSeparator
		NodeParseNodeName : TokIdentifier
		virtual TokKWPrecedence
		NodePrattLeftPrecedenceValue : TokInteger
		virtual TokSemicolon
	};
	
	PRATT_OPERATOR_DEF_PREFIX -> NodePrattOperatorDef {
		NodeParseSymbolReference : TokIdentifier
		virtual TokChainSeparator
		NodeParseNodeName : TokIdentifier
		virtual TokKWPrecedence
		NodePrattRightPrecedenceValue : TokInteger
		virtual TokSemicolon
	};
	
	PRATT_POSTFIX -> NodePrattPostfix {
		NodePrattKeyword : TokKWPostfix
		PRATT_POSTFIX_BODY
	};
	
	PRATT_POSTFIX_BODY -> NodePrattPostfixBody sync (TokBraceClose) {
		nest TokBraceOpen TokBraceClose {
			PRATT_POSTFIX_LIST
		}
	};
	
	PRATT_POSTFIX_LIST -> transparent gr_PRATT_POSTFIX_LIST {
		(
			PRATT_OPERATOR_DEF_POSTFIX
		)*
	};
	
	PRATT_PREFIX -> NodePrattPrefix {
		NodePrattKeyword : TokKWPrefix
		PRATT_PREFIX_BODY
	};
	
	PRATT_PREFIX_BODY -> NodePrattPrefixBody sync (TokBraceClose) {
		nest TokBraceOpen TokBraceClose {
			PRATT_PREFIX_LIST
		}
	};
	
	PRATT_PREFIX_LIST -> transparent gr_PRATT_PREFIX_LIST {
		(
			PRATT_OPERATOR_DEF_PREFIX
		)*
	};
	
	PRATT_PRIMARY -> NodePrattPrimary {
		NodePrattKeyword : TokKWPrimary
		PRATT_PRIMARY_BODY
	};
	
	PRATT_PRIMARY_BODY -> NodePrattPrimaryBody sync (TokBraceClose) {
		nest TokBraceOpen TokBraceClose {
			PRATT_PRIMARY_REF
		}
	};
	
	PRATT_PRIMARY_REF -> NodePrattPrimaryRef {
		NodeParseExpressionReference : TokIdentifier
		virtual TokSemicolon
	};
	
	PRATT_SECTION -> NodePrattSection sync (TokSemicolon TokBraceClose) {
		NodePrattKeyword : TokKWPratt
		PRATT_SECTION_BLOCK_NEST
		virtual TokSemicolon?
	};
	
	PRATT_SECTION_BLOCK_NEST -> transparent gr_PRATT_SECTION_BLOCK_NEST sync (TokBraceClose) {
		nest TokBraceOpen TokBraceClose {
			PRATT_EXPR_DEF_LIST
		}
	};
	
	PREDICT_LOOKAHEAD -> NodePredictLookahead {
		NodePredictOffset : TokInteger
		virtual TokAssignment
		NodePredictToken : TokIdentifier
		virtual TokComma?
	};
	
	PREDICT_LOOKAHEAD_ITEMS -> transparent gr_PREDICT_LOOKAHEAD_ITEMS {
		(
			PREDICT_LOOKAHEAD
		)*
	};
	
	PREDICT_LOOKAHEAD_LIST -> NodePredictLookaheadList sync (TokParenClose) {
		nest TokParenOpen TokParenClose {
			PREDICT_LOOKAHEAD_ITEMS
		}
	};
	
	PROGRAM -> NodeProgram {
		HEADER
		(
			PRAGMA_SECTION
		)?
		(
			PATTERN_SECTION
		)?
		LEX_SECTION
		(
			PRATT_SECTION
		)?
		PARSE_SECTION
		virtual TokEOF
	};
	
	REPETITION_BOUNDS -> transparent gr_REPETITION_BOUNDS {
		REPETITION_BOUNDS_STARTS_WITH_MIN | REPETITION_BOUNDS_STARTS_WITH_COMMA
	};
	
	REPETITION_BOUNDS_MIN_COMMA_MAX_OPT_SEQ -> transparent gr_REPETITION_BOUNDS_MIN_COMMA_MAX_OPT_SEQ {
		virtual TokComma
		NodeRepetitionMax : TokInteger?
	};
	
	REPETITION_BOUNDS_NEST -> transparent gr_REPETITION_BOUNDS_NEST sync (TokBraceClose) {
		nest TokBraceOpen TokBraceClose {
			REPETITION_BOUNDS
		}
	};
	
	REPETITION_BOUNDS_STARTS_WITH_COMMA -> NodeRepetitionBounds {
		virtual TokComma
		NodeRepetitionMax : TokInteger
	};
	
	REPETITION_BOUNDS_STARTS_WITH_MIN -> NodeRepetitionBounds {
		NodeRepetitionMin : TokInteger
		(
			REPETITION_BOUNDS_MIN_COMMA_MAX_OPT_SEQ
		)?
	};
	
	RULE_MODIFIER_SYNC -> NodeRuleModifierSync {
		virtual TokKWSync
		SYNC_BLOCK
	};
	
	SYNC_BLOCK -> NodeSyncBlock sync (TokParenClose) {
		nest TokParenOpen TokParenClose {
			SYNC_TOKEN_LIST
		}
	};
	
	SYNC_TOKEN_LIST -> transparent gr_SYNC_TOKEN_LIST {
		NodeSyncToken : TokIdentifier*
	};
}
