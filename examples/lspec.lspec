--- "LangSpec DSL" v0.0.0 | lspec v1.0.0 ---

PRAGMA {
	tool.sublime {
		enable = true;
		output-path = [
			"/home/user/.config/sublime-text/Packages/User/LSpec.sublime-syntax" // path 1
		];
	}
	
	tool.go_bindings {
		enable = true;
		output-path = "libs/langspec/examples/generated_go_bindings.go";
		package-name = "compiler";
	}
	
	tool.tm_comments {
		enable = true;
		output-path = [
			"libs/langspec/examples/generated_tm_comments.tmPreferences", // path 1,
			"/home/user/.config/sublime-text/Packages/User/Comments (LSpec).tmPreferences" // path 2
		];
		scope-extension = ".lspec";
		single-line-comment-start = "// ";
		block-comment-start = "/*";
		block-comment-end = "*/";
	}
}

PATTERN {
	pat_TokDashes : "---";
	pat_TokMetaSection : "%%";
	pat_TokPipe : "|";
	pat_TokDot : ".";
	pat_TokSemicolon : ";";
	pat_TokBraceOpen : "{";
	pat_TokBraceClose : "}";
	pat_TokParenOpen : "(";
	pat_TokParenClose : ")";
	pat_TokBracketOpen : "[";
	pat_TokBracketClose : "]";
	pat_TokComma : ",";
	pat_TokPlus : "+";
	pat_TokNegation : "!";
	pat_TokColon : ":";
	pat_TokChainSeparator : "->";
	pat_TokEqualsOperator : "=";
	pat_TokOptional : "?";
	pat_TokRange : "..";
	pat_TokStar : "*";
	pat_TokKWLSpec : "lspec";
	pat_TokKWPragma : "PRAGMA";
	pat_TokKWTool : "tool";
	pat_TokKWLex : "LEX";
	pat_TokKWPattern : "PATTERN";
	pat_TokKWPratt : "PRATT";
	pat_TokKWTrue : "true";
	pat_TokKWFalse : "false";
	pat_TokKWLocal : "local";
	pat_TokKWParse : "PARSE";
	pat_TokKWVirtual : "virtual";
	pat_TokKWNest : "nest";
	pat_TokKWPrimary : "primary";
	pat_TokKWPrefix : "prefix";
	pat_TokKWPostfix : "postfix";
	pat_TokKWInfix : "infix";
	pat_TokKWImplicit : "implicit";
	pat_TokKWPrecedence : "precedence";
	pat_TokKWIgnore : "IGNORE";
	pat_TokKWState : "state";
	pat_TokKWTransparent : "transparent";
	pat_TokKWSync : "sync";
	pat_TokKWPredict : "predict";
	pat_TokKWPush : "push";
	pat_TokKWPop : "pop";
	pat_TokKWSet : "set";
	pat_TokKWPair : "pair";
	pat_TokKWTemplate : "template";
	pat_TokKWCall : "call";
	pat_TokKWRule : "rule";
	pat_TokTypeToken : "Token";
	pat_TokTypeRule : "Rule";
	pat_TokTypeNode : "Node";
	pat_TokTypePair : "Pair";
	pat_TokTypePrattExpr : "PrattExpr";
	pat_TokEOF : [];
	pat_TokWhitespace : (['\t', '\n', '\r', ' '])+;
	pat_TokLineComment : "/" "/" (!['\n', '\r'])*;
	pat_TokBlockComment : "/" "*" ((!'*' | ("*")+ !['*', '/']))* ("*")+ "/";
	pat_TokInteger : ('0'..'9')+;
	pat_TokStringLiteral : "\"" ((!['\n', '\r', '"', '\\'] | ("\\" ['"', '\\', 'n', 'r', 't'] | ("\\u" (['0'..'9', 'A'..'F', 'a'..'f']){4,4} | "\\U" (['0'..'9', 'A'..'F', 'a'..'f']){8,8}))))* "\"";
	pat_TokRegexLiteral : "`" ((!['\\', '`'] | "\\" '\u0000'..'\U0010FFFF'))* "`";
	pat_TokVersion : "v" ('0'..'9')+ "." ('0'..'9')+ "." ('0'..'9')+;
	pat_TokCharLiteral : "'" (!['\n', '\r', '\'', '\\'] | ("\\" ['\'', '\\', 'n', 'r', 't'] | ("\\u" (['0'..'9', 'A'..'F', 'a'..'f']){4,4} | "\\U" (['0'..'9', 'A'..'F', 'a'..'f']){8,8}))) "'";
	pat_TokIdentifier : ['A'..'Z', '_', 'a'..'z'] (['-', '0'..'9', 'A'..'Z', '_', 'a'..'z'])*;
	pat_TokPairReference : "@" ['A'..'Z', '_', 'a'..'z'] (['-', '0'..'9', 'A'..'Z', '_', 'a'..'z'])*;
	pat_TokParameter : "$" ['A'..'Z', '_', 'a'..'z'] (['-', '0'..'9', 'A'..'Z', '_', 'a'..'z'])*;
}

LEX {
	state INITIAL {
		2 TokKWCall         -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWCall        ;
		2 TokKWFalse        -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWFalse       ;
		2 TokKWIgnore       -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWIgnore      ;
		2 TokKWImplicit     -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWImplicit    ;
		2 TokKWInfix        -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWInfix       ;
		2 TokKWLSpec        -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWLSpec       ;
		2 TokKWLex          -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWLex         ;
		2 TokKWLocal        -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWLocal       ;
		2 TokKWNest         -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWNest        ;
		2 TokKWPair         -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWPair        ;
		2 TokKWParse        -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWParse       ;
		2 TokKWPattern      -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWPattern     ;
		2 TokKWPop          -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWPop         ;
		2 TokKWPostfix      -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWPostfix     ;
		2 TokKWPragma       -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWPragma      ;
		2 TokKWPratt        -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWPratt       ;
		2 TokKWPrecedence   -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWPrecedence  ;
		2 TokKWPredict      -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWPredict     ;
		2 TokKWPrefix       -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWPrefix      ;
		2 TokKWPrimary      -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWPrimary     ;
		2 TokKWPush         -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWPush        ;
		2 TokKWRule         -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWRule        ;
		2 TokKWSet          -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWSet         ;
		2 TokKWState        -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWState       ;
		2 TokKWSync         -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWSync        ;
		2 TokKWTemplate     -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWTemplate    ;
		2 TokKWTool         -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWTool        ;
		2 TokKWTransparent  -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWTransparent ;
		2 TokKWTrue         -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWTrue        ;
		2 TokKWVirtual      -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokKWVirtual     ;
		2 TokTypeNode       -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokTypeNode      ;
		2 TokTypePair       -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokTypePair      ;
		2 TokTypePrattExpr  -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokTypePrattExpr ;
		2 TokTypeRule       -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokTypeRule      ;
		2 TokTypeToken      -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokTypeToken     ;
		
		1 TokCharLiteral    -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokCharLiteral   ;
		1 TokIdentifier     -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokIdentifier    ;
		1 TokPairReference  -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokPairReference ;
		1 TokParameter      -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokParameter     ;
		1 TokRegexLiteral   -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokRegexLiteral  ;
		1 TokStringLiteral  -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokStringLiteral ;
		1 TokVersion        -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokVersion       ;
		
		0 TokBlockComment   -> LANG_SPEC_COMMENT_ROLE    : pat_TokBlockComment  ;
		0 TokBraceClose     -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokBraceClose    ;
		0 TokBraceOpen      -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokBraceOpen     ;
		0 TokBracketClose   -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokBracketClose  ;
		0 TokBracketOpen    -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokBracketOpen   ;
		0 TokChainSeparator -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokChainSeparator;
		0 TokColon          -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokColon         ;
		0 TokComma          -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokComma         ;
		0 TokDashes         -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokDashes        ;
		0 TokDot            -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokDot           ;
		0 TokEOF            -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokEOF            %% EOF=true %%;
		0 TokEqualsOperator -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokEqualsOperator;
		0 TokInteger        -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokInteger       ;
		0 TokLineComment    -> LANG_SPEC_COMMENT_ROLE    : pat_TokLineComment   ;
		0 TokMetaSection    -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokMetaSection   ;
		0 TokNegation       -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokNegation      ;
		0 TokOptional       -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokOptional      ;
		0 TokParenClose     -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokParenClose    ;
		0 TokParenOpen      -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokParenOpen     ;
		0 TokPipe           -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokPipe          ;
		0 TokPlus           -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokPlus          ;
		0 TokRange          -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokRange         ;
		0 TokSemicolon      -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokSemicolon     ;
		0 TokStar           -> LANG_SPEC_STRUCTURAL_ROLE : pat_TokStar          ;
		0 TokWhitespace     -> LANG_SPEC_WHITESPACE_ROLE : pat_TokWhitespace    ;
	}
}

PRATT {
	// In an automatically generated .lspec file, pratt is not present.
	// Namely, it has been "resolved"/"flattened" into normal parsing rules.
}

PARSE {
	IGNORE {
		LANG_SPEC_COMMENT_ROLE LANG_SPEC_WHITESPACE_ROLE
	};
	
	// Generated delimiter pairs for nest @Name
	pair GenPair_TokDashes_TokDashes TokDashes TokDashes;
	pair GenPair_TokBraceOpen_TokBraceClose TokBraceOpen TokBraceClose;
	pair GenPair_TokParenOpen_TokParenClose TokParenOpen TokParenClose;
	pair GenPair_TokBracketOpen_TokBracketClose TokBracketOpen TokBracketClose;
	pair GenPair_TokMetaSection_TokMetaSection TokMetaSection TokMetaSection;
	
	// Fingerprinted templates (repeated grammar structure)
	template GenTempl_0($g0 : Token, $g1 : Rule) {
		(
			virtual $g0
			$g1
		)*
	}
	
	rule DUMMY_CHOICE_FOR_PATTERNS -> transparent gr_DUMMY_CHOICE_FOR_PATTERNS {
		DUMMY_LOCAL_VAR_FOR_PATTERNS | NodePatternDefName : TokIdentifier
	};
	
	rule DUMMY_CHOICE_FOR_PRAGMA_VALUES -> transparent gr_DUMMY_CHOICE_FOR_PRAGMA_VALUES {
		PRAGMA_VALUE
		| NodePragmaValue : (
			NodePragmaValue : TokIdentifier
			| NodePragmaValue : TokStringLiteral
			| NodePragmaValue : TokKWTrue
			| NodePragmaValue : TokKWFalse
		)
	};
	
	rule DUMMY_CHOICE_NEST -> transparent gr_DUMMY_CHOICE_NEST {
		NodeParseExpressionReference : TokIdentifier | PARSE_NEST_BODY
	};
	
	rule DUMMY_CHOICE_PARSE_BLOCK_CHOICE -> transparent gr_DUMMY_CHOICE_PARSE_BLOCK_CHOICE {
		PARSE_RULE | PARSE_PAIR_DECLARATION | PARSE_TEMPLATE_DECLARATION
	};
	
	rule DUMMY_CHOICE_PARSE_BLOCK_LIST -> transparent gr_DUMMY_CHOICE_PARSE_BLOCK_LIST {
		(
			DUMMY_CHOICE_PARSE_BLOCK_CHOICE
		)*
	};
	
	rule DUMMY_LOCAL_VAR_FOR_PATTERNS -> transparent gr_DUMMY_LOCAL_VAR_FOR_PATTERNS {
		NodeLocalVariable : TokKWLocal
		NodePatternDefName : TokIdentifier
	};
	
	rule DUMMY_CHOICE_IDENT_MAP_BASE -> transparent gr_DUMMY_CHOICE_IDENT_MAP_BASE {
		NodeParseSymbolReference : TokIdentifier
		| NodeParseTemplateParameterReference : TokParameter
	};
	
	rule DUMMY_CHOICE_VIRTUAL_MAPPING -> transparent gr_DUMMY_CHOICE_VIRTUAL_MAPPING {
		NodeParseTokenReference : TokIdentifier
		| NodeParseTemplateParameterReference : TokParameter
	};
	
	rule HEADER -> transparent gr_HEADER sync (TokDashes) {
		nest @GenPair_TokDashes_TokDashes {
			HEADER_CONTENT
		}
	};
	
	rule HEADER_CONTENT -> NodeHeader {
		NodeDSLName : TokStringLiteral
		NodeVersion : TokVersion
		virtual TokPipe
		NodeLSPECName : TokKWLSpec
		NodeVersion : TokVersion
	};
	
	rule LEX_RULE -> NodeLexRule sync (TokSemicolon) {
		NodeLexRulePriority : TokInteger?
		NodeLexRuleTokenName : TokIdentifier
		virtual TokChainSeparator
		NodeLexRuleRole : TokIdentifier
		virtual TokColon
		(
			LEX_RULE_PATTERN
		)
		LEX_RULE_STATE_MUTATION?
		META_SECTION?
		virtual TokSemicolon
	};
	
	rule LEX_RULE_LIST -> transparent gr_LEX_RULE_LIST sync (TokSemicolon) {
		(
			LEX_RULE
		)*
	};
	
	rule LEX_RULE_PATTERN -> transparent gr_LEX_RULE_PATTERN {
		PATTERN_REF | NodeLexRulePattern : TokRegexLiteral
	};
	
	rule LEX_RULE_STATE_MUTATION -> NodeLexRuleStateMutation sync (TokBracketClose) {
		nest @GenPair_TokBracketOpen_TokBracketClose {
			LEX_RULE_STATE_MUTATION_KIND
		}
	};
	
	rule LEX_RULE_STATE_MUTATION_KIND -> transparent gr_LEX_RULE_STATE_MUTATION_KIND {
		STATE_MUTATION_PUSH | STATE_MUTATION_POP | STATE_MUTATION_SET
	};
	
	rule LEX_SECTION -> NodeLexSection {
		NodeLexKeyword : TokKWLex
		LEX_SECTION_BLOCK_NEST
		virtual TokSemicolon?
	};
	
	rule LEX_SECTION_BLOCK_NEST -> transparent gr_LEX_SECTION_BLOCK_NEST sync (TokBraceClose) {
		nest @GenPair_TokBraceOpen_TokBraceClose {
			STATE_LIST_BLOCKS
		}
	};
	
	rule META_KEY_VALUE_PAIR -> transparent gr_META_KEY_VALUE_PAIR {
		(
			META_KEY_VALUE_SEQUENCE
		)*
	};
	
	rule META_KEY_VALUE_SEQUENCE -> NodeMetaKeyValuePair {
		NodeMetaKey : TokIdentifier
		virtual TokEqualsOperator
		(
			NodeMetaValue : (
				NodeMetaValue : TokStringLiteral
				| NodeMetaValue : TokKWFalse
				| NodeMetaValue : TokKWTrue
			)
		)
	};
	
	rule META_SECTION -> NodeMetaSection sync (TokMetaSection) {
		nest @GenPair_TokMetaSection_TokMetaSection {
			META_KEY_VALUE_PAIR
		}
	};
	
	rule PARSE_EXPRESSION -> transparent gr_PARSE_EXPRESSION {
		PARSE_EXPRESSION_BP_10
	};
	
	rule PARSE_EXPRESSION_BP_10 -> transparent gr_PARSE_EXPRESSION_BP_10 {
		PARSE_EXPRESSION_BP_20
		call GenTempl_0(TokPipe, PARSE_EXPRESSION_BP_20)
	};
	
	rule PARSE_EXPRESSION_BP_20 -> transparent gr_PARSE_EXPRESSION_BP_20 {
		PARSE_EXPRESSION_BP_30
		PARSE_EXPRESSION_BP_30*
	};
	
	rule PARSE_EXPRESSION_BP_30 -> transparent gr_PARSE_EXPRESSION_BP_30 {
		PARSE_EXPRESSION_BP_40
		(
			virtual TokOptional | virtual TokStar | virtual TokPlus | REPETITION_BOUNDS_NEST
		)*
	};
	
	rule PARSE_EXPRESSION_BP_40 -> transparent gr_PARSE_EXPRESSION_BP_40 {
		(
			PARSE_MODIFIER_PREDICT
		)*
		(
			PARSE_SEGMENT
		)
	};
	
	rule PARSE_GROUP -> NodeParseGroup sync (TokParenClose) {
		nest @GenPair_TokParenOpen_TokParenClose PARSE_EXPRESSION
	};
	
	rule PARSE_IGNORE_ROLE_LIST -> transparent gr_PARSE_IGNORE_ROLE_LIST {
		NodeParseIgnoreRole : TokIdentifier*
	};
	
	rule PARSE_IGNORE_SECTION -> NodeParseIgnoreSection sync (TokBraceClose) {
		NodeParseIgnoreKeyword : TokKWIgnore
		PARSE_IGNORE_SECTION_BLOCK_NEST
		virtual TokSemicolon?
	};
	
	rule PARSE_IGNORE_SECTION_BLOCK_NEST -> transparent gr_PARSE_IGNORE_SECTION_BLOCK_NEST sync (TokBraceClose) {
		nest @GenPair_TokBraceOpen_TokBraceClose {
			PARSE_IGNORE_ROLE_LIST
		}
	};
	
	rule PARSE_MODIFIER_PREDICT -> NodeParseModifierPredict {
		virtual TokKWPredict
		PREDICT_LOOKAHEAD_LIST
	};
	
	rule PARSE_NEST_BODY -> NodeParseNestBody sync (TokBraceClose) {
		nest @GenPair_TokBraceOpen_TokBraceClose PARSE_EXPRESSION
	};
	
	rule PARSE_OP_NEST -> NodeParseOpNest {
		virtual TokKWNest
		(
			PARSE_OP_NEST_CHOICE
		)
		(
			RULE_MODIFIER_SYNC
		)?
		(
			DUMMY_CHOICE_NEST
		)
	};
	
	rule PARSE_OP_NEST_CHOICE -> transparent gr_PARSE_OP_NEST_CHOICE {
		PARSE_OP_NEST_EXPLICIT
		| NodeParseNestPairRef : TokPairReference
		| NodeParseTemplateParameterReference : TokParameter
	};
	
	rule PARSE_OP_NEST_EXPLICIT -> transparent gr_PARSE_OP_NEST_EXPLICIT {
		NodeParseNestOpenToken : TokIdentifier
		NodeParseNestCloseToken : TokIdentifier
	};
	
	rule PARSE_OP_SUPPRESS -> NodeParseOpSuppress {
		virtual TokKWVirtual
		(
			DUMMY_CHOICE_VIRTUAL_MAPPING
		)
	};
	
	rule PARSE_PAIR_DECLARATION -> NodeParsePair sync (TokSemicolon) {
		virtual TokKWPair
		NodeParsePairIdentifier : TokIdentifier
		NodeParseTokenReference : TokIdentifier
		NodeParseTokenReference : TokIdentifier
		virtual TokSemicolon
	};
	
	rule PARSE_RULE -> NodeParseRule sync (TokSemicolon) {
		virtual TokKWRule
		NodeParseRuleName : TokIdentifier
		virtual TokChainSeparator
		NodeRuleModifierTransparent : TokKWTransparent?
		NodeParseNodeName : TokIdentifier
		(
			RULE_MODIFIER_SYNC
		)?
		PARSE_RULE_BODY
		virtual TokSemicolon?
	};
	
	rule PARSE_RULE_BODY -> NodeParseRuleBody sync (TokBraceClose) {
		nest @GenPair_TokBraceOpen_TokBraceClose PARSE_EXPRESSION
	};
	
	rule PARSE_SECTION -> NodeParseSection {
		NodeParseKeyword : TokKWParse
		PARSE_SECTION_BLOCK_NEST
		virtual TokSemicolon?
	};
	
	rule PARSE_SECTION_BLOCK_NEST -> transparent gr_PARSE_SECTION_BLOCK_NEST sync (TokBraceClose) {
		nest @GenPair_TokBraceOpen_TokBraceClose {
			PARSE_SECTION_BODY
		}
	};
	
	rule PARSE_SECTION_BODY -> NodeParseSectionBody {
		(
			PARSE_IGNORE_SECTION
		)?
		DUMMY_CHOICE_PARSE_BLOCK_LIST
	};
	
	rule PARSE_SEGMENT -> transparent gr_PARSE_SEGMENT {
		PARSE_OP_SUPPRESS
		| PARSE_OP_NEST
		| PARSE_GROUP
		| PARSE_SEGMENT_TEMPLATE_CALL_SEGMENT
		| PARSE_SEGMENT_IDENT_MAPPING_OR_CALL
	};
	
	rule PARSE_SEGMENT_IDENT_MAPPING_OR_CALL -> NodeParseSegment {
		(
			DUMMY_CHOICE_IDENT_MAP_BASE
		)
		(
			PARSE_SEGMENT_MAPPING_TAIL
		)?
	};
	
	rule PARSE_SEGMENT_MAPPING_TAIL -> NodeParseSegment {
		virtual TokColon
		(
			PARSE_SEGMENT_MAPPING_TARGET_CHOICE
		)
	};
	
	rule PARSE_SEGMENT_MAPPING_TARGET_CHOICE -> transparent gr_PARSE_SEGMENT_MAPPING_TARGET_CHOICE {
		PARSE_GROUP
		| NodeParseTokenReference : TokIdentifier
		| NodeParseTemplateParameterReference : TokParameter
	};
	
	rule PARSE_SEGMENT_TEMPLATE_CALL_SEGMENT -> NodeParseSegment {
		NodeParseTemplateCallKeyword : TokKWCall
		NodeParseTemplateReference : TokIdentifier
		PARSE_TEMPLATE_CALL_ARGS
	};
	
	rule PARSE_TEMPLATE_BODY -> NodeParseTemplateBody sync (TokBraceClose) {
		nest @GenPair_TokBraceOpen_TokBraceClose PARSE_EXPRESSION
	};
	
	rule PARSE_TEMPLATE_CALL_ARGS -> NodeParseTemplateCallArgs sync (TokParenClose) {
		nest @GenPair_TokParenOpen_TokParenClose {
			TEMPLATE_CALL_ARGUMENT_LIST_DUMMY
		}
	};
	
	rule PARSE_TEMPLATE_DECLARATION -> NodeParseTemplate {
		virtual TokKWTemplate
		NodeParseTemplateIdentifier : TokIdentifier
		PARSE_TEMPLATE_SIGNATURE
		PARSE_TEMPLATE_BODY
	};
	
	rule PARSE_TEMPLATE_PARAMETER -> NodeParseTemplateParameter {
		NodeParseTemplateParameterIdentifier : TokParameter
		virtual TokColon
		(
			NodeParseTemplateParameterType : (
				NodeParseTemplateParameterType : TokTypeToken
				| NodeParseTemplateParameterType : TokTypeNode
				| NodeParseTemplateParameterType : TokTypeRule
				| NodeParseTemplateParameterType : TokTypePair
				| NodeParseTemplateParameterType : TokTypePrattExpr
			)
		)
	};
	
	rule PARSE_TEMPLATE_PARAMETER_LIST -> NodeParseTemplateParameterList {
		PARSE_TEMPLATE_PARAMETER
		TEMPLATE_ARGUMENT_LIST_TAIL
	};
	
	rule PARSE_TEMPLATE_SIGNATURE -> transparent gr_PARSE_TEMPLATE_SIGNATURE sync (TokParenClose) {
		nest @GenPair_TokParenOpen_TokParenClose {
			(
				PARSE_TEMPLATE_PARAMETER_LIST
			)?
		}
	};
	
	rule PATTERN_CLASS -> NodePatternClass sync (TokBracketClose) {
		nest @GenPair_TokBracketOpen_TokBracketClose {
			PATTERN_CLASS_ITEM_LIST
		}
	};
	
	rule PATTERN_CLASS_ITEM_COMMA -> NodePatternClassItem {
		PATTERN_CLASS_ITEM_SEQ
		virtual TokComma?
	};
	
	rule PATTERN_CLASS_ITEM_LIST -> transparent gr_PATTERN_CLASS_ITEM_LIST {
		(
			PATTERN_CLASS_ITEM_COMMA
		)*
	};
	
	rule PATTERN_CLASS_ITEM_SEQ -> NodePatternClassItem {
		NodeCharLiteral : TokCharLiteral
		(
			PATTERN_RANGE_TAIL
		)?
	};
	
	rule PATTERN_DEFINITION -> NodePatternDefinition sync (TokSemicolon) {
		(
			DUMMY_CHOICE_FOR_PATTERNS
		)
		virtual TokColon
		PATTERN_EXPRESSION
		virtual TokSemicolon
	};
	
	rule PATTERN_DEFINITION_LIST -> transparent gr_PATTERN_DEFINITION_LIST sync (TokSemicolon) {
		(
			PATTERN_DEFINITION
		)*
	};
	
	rule PATTERN_EXPRESSION -> transparent gr_PATTERN_EXPRESSION {
		PATTERN_EXPRESSION_BP_10
	};
	
	rule PATTERN_EXPRESSION_BP_10 -> transparent gr_PATTERN_EXPRESSION_BP_10 {
		PATTERN_EXPRESSION_BP_20
		call GenTempl_0(TokPipe, PATTERN_EXPRESSION_BP_20)
	};
	
	rule PATTERN_EXPRESSION_BP_20 -> transparent gr_PATTERN_EXPRESSION_BP_20 {
		PATTERN_EXPRESSION_BP_30
		PATTERN_EXPRESSION_BP_30*
	};
	
	rule PATTERN_EXPRESSION_BP_30 -> transparent gr_PATTERN_EXPRESSION_BP_30 {
		PATTERN_EXPRESSION_BP_40
